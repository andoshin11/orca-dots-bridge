{
  "name": "orca-dots-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Orca visibility and explicit single-agent instruction bridge",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "vp pack",
