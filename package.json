{
  "name": "orca-dots-bridge",
  "version": "0.3.1",
  "private": true,
  "description": "Lets ChatGPT (dot) check Orca agent status on your Mac and send one explicit instruction to one agent",
  "keywords": [
    "chatgpt",
    "macos",
    "mcp",
    "model-context-protocol",
    "orca",
    "secure-mcp-tunnel"
  ],
  "homepage": "https://github.com/andoshin11/orca-dots-bridge#readme",
  "bugs": {
    "url": "https://github.com/andoshin11/orca-dots-bridge/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andoshin11/orca-dots-bridge.git"
  },
  "os": [
    "darwin"
  ],
  "type": "module",
  "scripts": {
    "build": "vp pack && node scripts/bundled-licenses.mjs",
    "check": "vp check",
    "lint": "vp lint",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vp test",
    "verify": "vp run verify-all",
    "start": "node dist/cli.mjs",
    "mcp": "node dist/mcp.mjs",
    "setup": "node dist/setup.mjs",
    "verify:local": "node scripts/verify-local.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.0",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "typescript": "5.9.3",
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "npm@11.19.0"
}
